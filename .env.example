# DeepSeek API key. Keep this server-side; do not use the NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# NEXT_PUBLIC_SUPABASE_URL: URL to your Supabase project (Project settings -> API -> URL)
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous key for your Supabase project (Project settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Secret service-role key (Project settings -> API -> service_role).
# Server-side only, bypasses RLS. Never expose to the client. Only needed to run one-off
# scripts in scripts/ (e.g. migrate-local-products-to-supabase.ts). Do not commit the real value.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
