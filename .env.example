# NEXT_PUBLIC_SITE_URL: Canonical origin of the site, no trailing slash. Used for
# canonical tags, Open Graph URLs, sitemap.xml and robots.txt. Defaults to
# https://cecelinachang.com when unset; set it on preview environments.
NEXT_PUBLIC_SITE_URL="https://cecelinachang.com"

# DeepSeek API key. Keep this server-side; do not use the NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# NEXT_PUBLIC_SUPABASE_URL: URL to your Supabase project (Project settings -> API -> URL)
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous key for your Supabase project (Project settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Secret service-role key (Project settings -> API -> service_role).
# Server-side only, bypasses RLS. Never expose to the client. Used by one-off scripts in
# scripts/ and by app/api/cron/lead-reminders (reads/updates leads without a logged-in admin).
# Do not commit the real value.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# RESEND_API_KEY: Resend API key (resend.com/api-keys) for the lead welcome + 48h
# follow-up emails (app/api/leads, app/api/cron/lead-reminders). Do not commit the real value.
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# CRON_SECRET: Random string. Vercel Cron sends it as "Authorization: Bearer <value>" so
# app/api/cron/lead-reminders can reject requests that didn't come from the scheduler.
CRON_SECRET="YOUR_RANDOM_SECRET"
